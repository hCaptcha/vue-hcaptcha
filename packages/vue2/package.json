{
  "name": "@hcaptcha/vue-hcaptcha",
  "version": "1.3.0",
  "types": "types/index.d.ts",
  "main": "./dist/@hcaptcha/vue-hcaptcha.umd.min.js",
  "module": "./dist/@hcaptcha/vue-hcaptcha.common.js",
  "files": [
    "dist/@hcaptcha",
    "types/index.d.ts"
  ],
  "author": "hCaptcha team and contributors",
  "homepage": "https://github.com/hCaptcha/vue-hcaptcha",
  "organization": "hCaptcha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hCaptcha/vue-hcaptcha.git",
    "web": "https://github.com/hCaptcha/vue-hcaptcha",
    "directory": "packages/vue2"
  },
  "bugs": {
    "url": "https://github.com/hCaptcha/vue-hcaptcha/issues"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:types",
    "test:unit": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service test:unit",
    "test:types": "tsc -p types/__tests__",
    "lint": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service lint --no-fix",
    "lint:fix": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service lint",
    "build": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --target lib --name @hcaptcha/vue-hcaptcha src/main.js",
    "serve": "npm run --prefix examples/traditional-vue2 serve",
    "serve:ts": "npm run --prefix examples/ts-vue2 serve"
  },
  "devDependencies": {
    "@actions/core": "^1.2.6",
    "@babel/core": "^7.23.2",
    "@babel/plugin-transform-modules-commonjs": "^7.2.0",
    "@babel/preset-env": "^7.23.2",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-plugin-unit-jest": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "@vue/test-utils": "^1.2.2",
    "@vue/vue2-jest": "^27.0.0",
    "autoprefixer": "^10.4.0",
    "babel-eslint": "^10.0.1",
    "babel-jest": "^27.5.1",
    "babel-loader": "^8.0.4",
    "eslint": "^7.32.0",
    "eslint-config-standard": "^12.0.0",
    "eslint-plugin-flowtype": "^3.2.0",
    "eslint-plugin-html": "^6.2.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-node": "^8.0.0",
    "eslint-plugin-promise": "^4.0.1",
    "eslint-plugin-standard": "^4.0.0",
    "eslint-plugin-vue": "^7.20.0",
    "jest": "^27.5.1",
    "jsdom": "^16.7.0",
    "jsdom-global": "^3.0.2",
    "node-fetch": "^2.6.1",
    "typescript": "^4.1.3",
    "vue": "^2.6.12",
    "vue-server-renderer": "^2.5.21",
    "vue-template-compiler": "^2.6.12"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {},
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "keywords": [
    "hcaptcha",
    "captcha",
    "component",
    "vue",
    "vue-component",
    "earn"
  ],
  "peerDependencies": {
    "vue": "^2.0.0"
  }
}
